# Files that are not part of the distributed composer package (cors/document-auth).
# The bundle itself is src/ (CORSDocumentAuthBundle::getPath(), Resources/ included) plus
# composer.json, README.md and the license files; everything below only serves the dev
# harness (Kernel.php, config/, dev/, docker-compose.yaml) or the CI.
/dev                                    export-ignore
/bin                                    export-ignore
/config                                 export-ignore
/public                                 export-ignore
/templates                              export-ignore
/var                                    export-ignore
/Kernel.php                             export-ignore
/docker-compose.yaml                    export-ignore
/.env                                   export-ignore
/.env.local                             export-ignore
/.gitattributes                         export-ignore
/.gitignore                             export-ignore
/.github                                export-ignore
/ecs.php                                export-ignore
/phpstan.neon                           export-ignore
/psalm.xml                              export-ignore
/tests                                  export-ignore
/phpunit.xml.dist                       export-ignore
