######################
# Compiled source    #
######################
*.com
*.class
*.dll
*.exe
*.o
*.so

######################
# Packages           #
######################
# it's better to unpack these files and commit the raw source
# git has its own built in compression methods
*.7z
*.dmg
*.gz
*.iso
*.jar

######################
# Logs and databases #
######################
*.log

######################
# Global             #
######################
.DS_Store
.DS_Store\?
._*
.Spotlight-V100
.Trashes
Icon\?
*.sublime-workspace
*.sublime-project
atlassian-ide-plugin.xml
.idea/
.project
Thumbs.db
phpda.html
# --- dev harness ---
# var is generated, but PHPStan (Pimcore extension) needs var/classes/DataObject in CI
/var/*
!/var/classes
/var/classes/*
!/var/classes/DataObject
/var/classes/DataObject/*
!/var/classes/DataObject/.gitkeep
/public/var
.env.local
public/bundles
web/bundles
# config.yaml imports local/*.yaml; the kernel fails without the directory in CI
/config/local/*
!/config/local/.gitkeep
app/config/local
vendor
supervisord.pid
node_modules
assets/@mf-types
assets/dist
# dev environment only, the bundle itself must not pin its PHP dependencies
/composer.lock
/.phpunit.cache/
config/reference.php
