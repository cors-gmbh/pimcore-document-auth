{
    "name": "cors/document-auth",
    "type": "pimcore-bundle",
    "description": "CORS - Document Auth",
    "keywords": [
        "pimcore",
        "basic-auth",
        "documents"
    ],
    "homepage": "https://www.cors.gmbh",
    "license": "MIT",
    "authors": [
        {
            "name": "CORS GmbH",
            "email": "office@cors.gmbh",
            "homepage": "https://www.cors.gmbh/",
            "role": "TEAM"
        }
    ],
    "require": {
        "php": "~8.4.0 || ~8.5.0",
        "pimcore/pimcore": "^2026.2"
    },
    "require-dev": {
        "coreshop/test-setup": "dev-main",
        "symfony/runtime": "^7.4",
        "symfony/dotenv": "^7.0",
        "pimcore/studio-backend-bundle": "^2026.1",
        "pimcore/studio-ui-bundle": "^2026.2"
    },
    "autoload": {
        "psr-4": {
            "CORS\\Bundle\\DocumentAuthBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "classmap": [
            "Kernel.php"
        ],
        "psr-4": {
            "App\\": "dev",
            "Pimcore\\Model\\DataObject\\": "var/classes/DataObject"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-2026.x": "2026.1.x-dev"
        },
        "pimcore": {
            "bundles": [
                "CORS\\Bundle\\DocumentAuthBundle\\CORSDocumentAuthBundle"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/runtime": true
        }
    }
}
